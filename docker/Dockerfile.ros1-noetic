# ROS 1 Noetic (Ubuntu 20.04) + rosbridge for Nano-sim.
# NOTE: Noetic is EOL (May 2025); prefer ROS 2 unless you need a Noetic stack.
# Build from the repo root:
#   docker build -f docker/Dockerfile.ros1-noetic -t nanosim-ros:noetic .
FROM ros:noetic-ros-base

RUN apt-get update && apt-get install -y --no-install-recommends \
        ros-noetic-rosbridge-suite \
        python3-pip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /ws
COPY examples/ros1/nanosim_driver.py /ws/nanosim_driver.py

EXPOSE 9090
# roslaunch auto-starts roscore if none is running.
CMD ["bash", "-lc", "source /opt/ros/noetic/setup.bash && roslaunch rosbridge_server rosbridge_websocket.launch"]
